{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PT fuel discount catalogue",
  "type": "object",
  "required": ["lastReviewed", "discounts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "lastReviewed": { "type": "string", "format": "date", "description": "Date the whole catalogue was last reviewed (YYYY-MM-DD)." },
    "brandAliases": {
      "type": "object",
      "description": "Maps DGEG brand names (uppercased, trimmed) to the brand name used in this file.",
      "additionalProperties": { "type": "string" }
    },
    "discounts": { "type": "array", "items": { "$ref": "#/$defs/discount" } }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cents"],
          "properties": {
            "type": { "const": "cpl", "description": "Cents per litre." },
            "cents": { "type": "number", "minimum": 0 },
            "balanceCents": { "type": "number", "minimum": 0, "description": "Only for kind=mixed: the part paid as balance." }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "pct"],
          "properties": { "type": { "const": "percent" }, "pct": { "type": "number", "minimum": 0, "maximum": 100 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "eur"],
          "properties": { "type": { "const": "perMonthEur", "description": "Fixed euros per month, spread over litres per month." }, "eur": { "type": "number", "minimum": 0 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "eur"],
          "properties": { "type": { "const": "perFillEur", "description": "Fixed euros per fill, spread over litres per fill." }, "eur": { "type": "number", "minimum": 0 } }
        }
      ]
    },
    "discount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "brands", "name", "kind", "value", "conditions", "source", "lastVerified", "defaultOn", "active"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "brands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "name": { "type": "string" },
        "group": { "type": "string", "description": "Discounts sharing a group don't stack; only the best one applies." },
        "kind": { "enum": ["instant", "balance", "mixed"] },
        "value": { "$ref": "#/$defs/value" },
        "weekendValue": { "$ref": "#/$defs/value", "description": "Replaces value on Saturdays/Sundays." },
        "days": { "enum": ["weekday", "weekend"], "description": "Discount only available on these days." },
        "minSpendEur": { "type": "number", "minimum": 0 },
        "maxLitresPerFill": { "type": "number", "exclusiveMinimum": 0 },
        "validFrom": { "type": "string", "format": "date" },
        "validUntil": { "type": "string", "format": "date" },
        "conditions": { "type": "string" },
        "source": { "type": "string", "pattern": "^https://" },
        "lastVerified": { "type": "string", "format": "date" },
        "defaultOn": { "type": "boolean" },
        "active": { "type": "boolean" }
      }
    }
  }
}
